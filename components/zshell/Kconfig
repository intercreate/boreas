menu "Boreas Shell (zshell)"

    config ZSHELL
        bool "Enable shell subsystem"
        default n
        help
            Enable the Zephyr-style interactive shell.

    config ZSHELL_CMD_BUFF_SIZE
        int "Command buffer size"
        default 128
        depends on ZSHELL

    config ZSHELL_PRINTF_BUFF_SIZE
        int "Printf buffer size"
        default 256
        depends on ZSHELL

    config ZSHELL_MAX_ROOT_CMDS
        int "Maximum number of root commands"
        default 32
        depends on ZSHELL

    config ZSHELL_MAX_ARGC
        int "Maximum number of command arguments"
        default 12
        depends on ZSHELL

    config ZSHELL_THREAD_STACK_SIZE
        int "Shell thread stack size (bytes)"
        default 4096
        depends on ZSHELL

    config ZSHELL_THREAD_PRIORITY
        int "Shell thread priority"
        default 5
        depends on ZSHELL

    config ZSHELL_PROMPT
        string "Default prompt string"
        default "boreas> "
        depends on ZSHELL

    config ZSHELL_PROMPT_CHANGE
        bool "Allow prompt change at runtime"
        default y
        depends on ZSHELL
        help
            Enable shell_prompt_change(). Adds a ZSHELL_PROMPT_BUFF_SIZE
            byte prompt buffer to each shell instance.
            Mirrors CONFIG_SHELL_PROMPT_CHANGE.

    config ZSHELL_PROMPT_BUFF_SIZE
        int "Prompt buffer size"
        range 2 40
        default 20
        depends on ZSHELL_PROMPT_CHANGE
        help
            Mirrors CONFIG_SHELL_PROMPT_BUFF_SIZE. Prompts of this length or
            longer (including NUL) are rejected with -EINVAL.

    config ZSHELL_START_OBSCURED
        bool "Display asterisk when echoing"
        default n
        depends on ZSHELL
        help
            Echo '*' instead of the typed character. Used for login prompts;
            toggle at runtime with shell_obscure_set().
            Mirrors CONFIG_SHELL_START_OBSCURED.

    config ZSHELL_CMD_ROOT
        string "Root command at init"
        default ""
        depends on ZSHELL
        help
            Restrict dispatch to this root command when the shell starts:
            typed input becomes its arguments and no other root command is
            reachable. Empty means the full command tree. Change at runtime
            with shell_set_root_cmd(). Mirrors CONFIG_SHELL_CMD_ROOT.

    config ZSHELL_HISTORY
        bool "Enable command history"
        default y
        depends on ZSHELL

    config ZSHELL_HISTORY_DEPTH
        int "Number of history entries"
        default 10
        depends on ZSHELL_HISTORY

    config ZSHELL_VT100
        bool "Enable VT100 escape sequence handling"
        default y
        depends on ZSHELL
        help
            Enable cursor movement, arrow keys, Home/End/Delete.

    config ZSHELL_TAB_COMPLETION
        bool "Enable tab completion"
        default y
        depends on ZSHELL

    config ZSHELL_ECHO
        bool "Enable character echo by default"
        default y
        depends on ZSHELL

    config ZSHELL_CMD_KERNEL
        bool "Enable built-in kernel commands (uptime, heap)"
        default y
        depends on ZSHELL

    config ZSHELL_CMD_LOG
        bool "Enable built-in log commands"
        default y
        depends on ZSHELL
        select ZSYS_LOG_MODULE

    config ZSHELL_CMD_THREAD
        bool "Enable built-in thread analyzer command"
        default y
        depends on ZSHELL
        select ZSYS_THREAD_ANALYZER

    config ZSHELL_CMD_DEVICE
        bool "Enable built-in device commands"
        default y
        depends on ZSHELL

endmenu
